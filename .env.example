# --- Core app / server ---
PORT=3000
JWT_SECRET=
# Comma-separated list of allowed CORS origins (e.g. https://app.example.com,https://admin.example.com).
# Defaults to allow-all (reflects request origin) when unset.
CORS_ALLOWED_ORIGINS=

# --- Database (Postgres) ---
# Credentials are intentionally left blank. Fill in your own — nothing here is
# a working default, and the service will not start until these are set.
DATABASE_TYPE=postgres
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_PORT=5432
WRITE_DATABASE_HOST=localhost
READ_DATABASE_HOST=localhost
DATABASE_QUERY_LOGGING=false
MAX_DB_CONNECTIONS=10
MIN_DB_CONNECTIONS=5
DB_SSL=false
# When DB_SSL=true, certificate validation is strict by default. Set to true only for
# environments (e.g. some managed Postgres self-signed setups) that require skipping it.
DB_SSL_ALLOW_SELF_SIGNED=false

# --- Shared social analytics config ---
SOCIALSTATS_CLIENT_TOKEN_SECRET=
INGESTION_RUN_LEASE_TTL_MINUTES=30
CONTENT_TIER_HOT_MAX_AGE_DAYS=7
CONTENT_TIER_WARM_MAX_AGE_DAYS=30
CONTENT_TIER_WARM_CADENCE_MINUTES=60
CONTENT_TIER_COOL_CADENCE_MINUTES=240
NODE_ENVIRONMENT=development
K_REVISION=

# --- Logger (winston file logger) ---
LOGS_BASE_PATH=./logs
MICROSERVICE_NAME_FOR_LOGS=social-analytics
MAX_DAYS_FOR_LOGS=14

# --- Meta / Facebook / Instagram ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_SYSTEM_USER_TOKEN=
META_ACCESS_TOKEN=
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v26.0
META_HTTP_TIMEOUT_MS=15000
META_HTTP_MAX_RETRIES=3
META_HTTP_RETRY_BASE_DELAY_MS=500
META_RATE_LIMIT_COOLDOWN_SECONDS=60
META_RATE_LIMIT_USAGE_THRESHOLD_PERCENT=80
META_RATE_LIMIT_RESYNC_INTERVAL_MS=60000
META_TIER_SOFT_USAGE_THRESHOLD_PERCENT=70
META_PROFILE_REFRESH_MIN_FRESH_MINUTES=60
META_PROFILE_SNAPSHOT_CRON_ENABLED=true
META_CONTENT_SNAPSHOT_CRON_ENABLED=true
META_STORY_SNAPSHOT_CRON_ENABLED=true
META_GEO_SNAPSHOT_CRON_ENABLED=true

# --- YouTube ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_AUTH_FILE_PATH=
YOUTUBE_HTTP_TIMEOUT_MS=15000
YOUTUBE_AUTH_FAILURE_TTL_MS=300000
YOUTUBE_DATA_V3_DAILY_UNIT_BUDGET=10000
YOUTUBE_ANALYTICS_DAILY_CALL_BUDGET=2000
YOUTUBE_QUOTA_RESERVE_PERCENT=10
YOUTUBE_QUOTA_RESYNC_INTERVAL_MS=60000
YOUTUBE_HOT_TIER_RESERVE_UNITS=1000

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=
TIKTOK_HTTP_TIMEOUT_MS=15000
TIKTOK_TOKEN_REFRESH_BUFFER_MS=300000
TIKTOK_OAUTH_STATE_TTL_MS=600000
TIKTOK_REQUESTS_PER_MINUTE=60
TIKTOK_DAILY_REQUEST_BUDGET=1000
TIKTOK_QUOTA_RESERVE_PERCENT=10
TIKTOK_MAX_VIDEO_PAGES=10
TIKTOK_DATA_RETENTION_DAYS=90

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_ORGANIZATION_URN=
LINKEDIN_API_VERSION=202608
LINKEDIN_HTTP_TIMEOUT_MS=15000
LINKEDIN_OAUTH_STATE_TTL_MS=600000
LINKEDIN_DAILY_APP_REQUEST_BUDGET=500
LINKEDIN_DAILY_MEMBER_REQUEST_BUDGET=100
LINKEDIN_QUOTA_RESERVE_PERCENT=10
